{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caa",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
}
