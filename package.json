{
  "name": "caa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "check": "pnpm format:check && pnpm lint:check && pnpm tsc && pnpm test",
    "build": "vite build",
    "typegen": "wrangler types",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint .",
    "prepare": "simple-git-hooks",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "preview:e2e": "pnpm build && pnpm preview",
    "tsc": "tsc --noEmit",
    "test:e2e": "playwright test -grep @smoke",
    "test:playwright": "playwright test",
    "validate": "pnpm lint:check && pnpm tsc && pnpm test:e2e",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.36.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.64",
    "@tanstack/router-plugin": "^1.167.34",
    "@tohuhono/ui": "^0.14.7",
    "@tohuhono/utils": "^0.14.2",
    "@unpic/react": "^1.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.63.0",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "wrangler": "^4.88.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "simple-git-hooks",
      "workerd"
    ]
  }
}
